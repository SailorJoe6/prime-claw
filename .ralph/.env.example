# Ralph Configuration
# Copy this file to .env and customize for your project

# Note: Prompt paths (.ralph/prompts/*.md) are hardcoded and not configurable.
#       This ensures they match the .gitignore pattern.

# Planning and specification state is stored in Backlog tasks for this repository.
# The generic plugin's version-1 folder compatibility is configured by projects
# that still retain that workflow; it is not selected here through environment
# paths.

# === Log Configuration ===
# Log directory
# Default: .ralph/logs
#LOG_DIR=.ralph/logs

# Error log path
# Default: .ralph/logs/ERROR_LOG.md
#ERROR_LOG=.ralph/logs/ERROR_LOG.md

# Execution log path (unattended stdout)
# Default: .ralph/logs/EXECUTION_LOG.md
#EXECUTION_LOG=.ralph/logs/EXECUTION_LOG.md

# === Container Configuration ===
# Container name (leave empty if not using containers)
# Default: empty
#CONTAINER_NAME=

# Container working directory (defaults to /<basename> where basename is current directory name)
# Default: /<basename>
#CONTAINER_WORKDIR=

# Container runtime (docker or podman)
# Default: docker
#CONTAINER_RUNTIME=docker

# === Behavior Flags ===
# Uncomment to use Codex instead of Claude
#USE_CODEX=1

# Uncomment to run a callback script after each pass
#CALLBACK=./validate.sh
