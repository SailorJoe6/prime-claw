# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/

# Env / secrets
.env
.env.local
*.local

# Local state
/tmp/
*.log
# Operator-local home embedding endpoint + rendered exact-host policy
.prime-claw/runtime.local.json
.prime-claw/runtime-policy.local.yaml

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Slice 4: staged gbrain build context (regenerated by apply-phase1-brain.sh from the zbrain checkout)
docker/phase1-brain/gbrain/

# Phase 2 build: staged gbrain context + build stamp (generated by bin/prime-claw build)
docker/runtime/gbrain/
docker/runtime/.build-stamp.json

# prime-claw: hash of the last-set github provider token (not the token itself)
.prime-claw-github-token.sha256
.prime-claw-ai-gateway-key.sha256
.prime-claw-codex-oauth.sha256

# handoff-chain extension: transient chain marker (never commit runtime state)
.prime/agent/state/
