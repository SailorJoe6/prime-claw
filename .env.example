# prime-claw tier-1 test driver — prime-agent install selection (Slice 2).
#
# Copy this file to .env (gitignored) and set EXACTLY ONE selector below.
# The driver (scripts/test-tier1.sh) fails fast if neither or both are set.
#
# Selector 1 — install a released prime-agent at an exact version via the
# vendor installer (the same mechanism bin/prime-claw uses; prime-agent is
# not on the public npm registry — releases come from the vendor's download
# base):
#
#   PRIME_AGENT_PINNED=0.9.3
#
# Selector 2 — build prime-agent from a local fork checkout (absolute path).
# The driver runs the fork's release:pack on the host, stages the tarballs
# into the container over a file: URL base, and installs from them:
#
#   PRIME_AGENT_SOURCE=/absolute/path/to/prime-agent
#
# Format: plain KEY=value lines, no inline comments, no shell quoting needed.
# An empty value counts as unset. Tests may point TIER1_ENV_FILE at another
# env file; .env at the repo root is the default.

PRIME_AGENT_PINNED=
# PRIME_AGENT_SOURCE=/absolute/path/to/prime-agent
