{
  "sandbox_name": "prime-claw",
  "image": "prime-claw-brain:0.1.0",
  "gateway": {
    "name": "openshell",
    "endpoint": "https://localhost:17670",
    "forbidden": [
      "nemoclaw"
    ]
  },
  "policy_file": "policies/runtime.yaml",
  "local_config_file": ".prime-claw/runtime.local.json",
  "embedding_policy_file": ".prime-claw/runtime-policy.local.yaml",
  "embedding_provider": "openai",
  "embedding_model": "Qwen3-Embedding-8B",
  "embedding_dimensions": 4096,
  "embedding_timeout_seconds": 1000,
  "embedding_api_key": "dummy",
  "embedding_database": "gbrain_qwen4096",
  "embedding_legacy_database": "gbrain",
  "provider_name": "prime-claw-ai-gateway",
  "model": "openai-codex/gpt-5.6-sol",
  "ai_gateway_host": "ai-gateway.zende.sk",
  "versions": {
    "openshell_min": "0.0.116"
  },
  "gbrain_source": "upstream",
  "gbrain_upstream_src": "~/gbrain",
  "gbrain_zbrain_src": "~/zbrain",
  "github_provider_name": "prime-claw-github",
  "github_profile": "github-push",
  "github_host": "github.com",
  "brain_repo": "JLandersZen/brain",
  "brain_branch": "main",
  "sb_brain_dir": "/sandbox/brain",
  "sb_brain_query_path": "/sandbox/.prime-claw/bin/brain-query",
  "sb_agents_file": "/sandbox/AGENTS.md",
  "codex_provider_name": "prime-claw-codex",
  "codex_profile": "codex",
  "host_settings_json": "~/.prime/agent/settings.json",
  "host_models_json": "~/.prime/agent/models.json",
  "host_auth_json": "~/.prime/agent/auth.json",
  "host_codex_auth_provider": "openai-codex"
}
